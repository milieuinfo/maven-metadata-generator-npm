{
  "type": "module",
  "name": "@milieuinfo/maven-metadata-generator-npm",
  "version": "0.5.2",
  "description": "",
  "main": "src/index.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "node --test",
    "build": "rm -rf build && pnpm install --frozen-lockfile && pnpm test && rollup -c rollup.config.mjs",
    "release": "pnpm run build && npm version $release_version && pnpm publish",
    "postversion": "git push && git push --tags"
  },
  "publishConfig": {
    "registry": "https://repo.omgeving.vlaanderen.be/artifactory/api/npm/acd-npm/"
  },
  "pnpm": {
    "overrides": {
      "underscore": "1.13.8"
    }
  },
  "keywords": [
    "milieuinfo",
    "metadata",
    "generator",
    "rdfjs",
    "dcat",
    "maven",
    "skos-generator",
    "skos-rules",
    "metadata-generator",
    "dcat-generator"
  ],
  "author": "Vlaamse Overheid, Departement omgeving",
  "license": "MIT",
  "dependencies": {
    "@rdfjs/dataset": "^2.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "@zazuko/env-node": "1.0.2",
    "adm-zip": "^0.6.1",
    "csvtojson": "^2.0.14",
    "glob": "^11.1.0",
    "js-yaml": "4.3.2",
    "json-2-csv": "^5.6.0",
    "jsonld": "9.0.0",
    "jsonpath": "1.3.0",
    "n3": "^1.26.0",
    "node-fetch": "^3.3.2",
    "parquetjs-lite": "^0.8.7",
    "rdf-validate-shacl": "^0.5.10",
    "roxi-js": "0.1.3",
    "xml-beautify": "^1.2.3",
    "xml-js": "1.6.11",
    "xml-writer": "^1.7.0"
  },
  "volta": {
    "node": "22.13.0",
    "pnpm": "9.15.9"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "rollup": "^4.66.0"
  }
}
